{
  "name": "authoritative-software",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "node scripts/prepare.mjs",
    "dev": "astro dev",
    "check": "astro check",
    "build": "node scripts/prepare.mjs && astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "npm run check && npm run build && npm test && npm run test:browser",
    "social:render": "node scripts/render-social.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.9",
    "@astrokjs/astro": "0.1.0-beta.1",
    "@astrokjs/okf": "0.1.0-beta.1",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "typescript": "6.0.3"
  }
}
