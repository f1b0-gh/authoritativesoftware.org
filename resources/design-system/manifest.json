    "components/StatusBanner/README.md",
    "components/bundle.css",
    "tokens.css"
  ],
  "libraries": [],
  "components": [
    {
      "name": "Button",
      "group": "Actions",
      "summary": "Square, 48px-tall actions, nearly always links to a reading page."
    },
    {
      "name": "DefinedTerm",
      "group": "Document",
      "summary": "Links a defined word back to its definition in the declaration, with a dotted underline that reads as \"defined term\" rather than \"external link\"."
    },
    {
      "name": "EditionChange",
      "group": "Document",
      "summary": "Shows exactly what changed in one provision between two editions of the declaration, with the reason."
    },
    {
      "name": "FindingLabel",
      "group": "Records",
      "summary": "A compact label for one finding about a claim."
    },
    {
      "name": "ProvisionMarker",
      "group": "Document",
      "summary": "Marks a block as declaration text (normative) or as explanation, so a reader never mistakes commentary for a requirement."
    },
    {
      "name": "RecordBlock",
      "group": "Records",
      "summary": "Three containers, for a statement (what an operator says), a finding (what an assessment found) and a decision (what a consumer chooses to rely on)."
    },
    {
      "name": "StatusBanner",
      "group": "Document",
      "summary": "Shows the declaration's status, version, publication date and a link to what changed, at the top of every declaration surface."
    }
  ],
