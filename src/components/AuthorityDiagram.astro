---
import BrandMark from './BrandMark.astro';
---
<figure class="authority-diagram">
  <div class="diagram-top"><span class="eyebrow">Claims and reliance</span><span class="diagram-tag">AUTHORITY.md</span></div>
  <div class="relationship-mark"><BrandMark /></div>
  <div class="relationship-labels"><span>Operator asserts</span><span>Consumer decides</span></div>
